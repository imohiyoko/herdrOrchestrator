#!/usr/bin/env bash
# tb — herdr agent 用の最小タスク表(SQLite 1 ファイル)
# usage: tb <コマンド> ...  (tb help で一覧)
#
# 中身は Go の herdrctl(herdrctl tb <コマンド>。internal/tbcli)。これは checkout の場所・DB・セッションを渡して置き換わるだけ。
# herdrctl は TB_HERDRCTL > PATH の herdrctl(setup が入れる)。
# 環境変数: TB_DB(DB パス) / TB_CONFIG(projects.conf) / HERDR_BIN(herdr の実体。テストでは疑似 herdr)
# 終了コード: 0 成功 / 1 エラー / 2 使い方の誤り
#             report のみ: 10 宛先が使用中などで未送信(pending に残る) / 11 送信・状態取得に失敗(pending に残る)
set -euo pipefail

# PATH に symlink で置かれても本体の場所を起点にする
_src=${BASH_SOURCE[0]}
while [[ -L $_src ]]; do _d=$(cd "$(dirname "$_src")" && pwd); _src=$(readlink "$_src"); [[ $_src == /* ]] || _src=$_d/$_src; done
TB_ROOT=$(cd "$(dirname "$_src")/.." && pwd)
unset _src _d
# shellcheck source=../../lib/herdr-env.sh
source "$TB_ROOT/../lib/herdr-env.sh"
herdr_session_apply   # checkout の herdr-session ファイルでセッションを固定していれば、herdr にも渡す
HC=${TB_HERDRCTL:-herdrctl}

cmd=${1:-help}
case $cmd in
  help|-h|--help)
    # tests/covmap.sh がユニットごとの記録を作るときだけ: help.txt を読んだユニットに印を付ける
    [[ -n ${TB_TEST_COVER_DIR-} && -n ${GOCOVERDIR-} ]] && : >"$GOCOVERDIR/read-help.txt"
    cat "$TB_ROOT/lib/help.txt"; exit 0;;
esac

# Go に渡す。TB_ROOT: checkout の taskboard(scheduler の場所・roles など)。TB_CONFIG_DIR: checkout の設定ファイル(statuses.conf など)
go_exec() {
  TB_ROOT=$TB_ROOT TB_DB=${TB_DB:-$HERDR_DEFAULT_TB_DB} TB_CONFIG_DIR=${TB_CONFIG_DIR:-$TB_ROOT/config} \
    HERDR_SESSION=$(herdr_session_name) HERDR_SOCKET_PATH='' exec "$HC" tb "$@"
}

if ! command -v "$HC" >/dev/null 2>&1; then
  case $cmd in touch|role-context) exit 0;; esac   # hook 用。何も出さず 0
  echo "error: herdrctl が見つかりません: $HC(setup で入れるか、TB_HERDRCTL で場所を指定)" >&2
  exit 1
fi
# 権限段階の門(ADR 0006)と呼び出し元の確かめ(ADR 0007)を持たない古い herdrctl には渡さない
f=$("$HC" tb --features 2>/dev/null) || f=""
if [[ " $f " != *" policy-ops "* || " $f " != *" auth "* ]]; then
  case $cmd in touch|role-context) exit 0;; esac
  echo "error: herdrctl が古く、認可と呼び出し元(ADR 0007)を確かめられないため渡しません: $HC(herdrctl を入れ直す)" >&2
  exit 1
fi
case $cmd in
  # 読み取りだけ。DB を開かない(壊れた DB でも今の向き先を確かめられる)。セッションの環境変数を書き換えずに渡す
  whoami) TB_ROOT=$TB_ROOT HERDR_ROOT=$HERDR_ROOT exec "$HC" tb "$@";;
  touch) ( go_exec "$@" ) >/dev/null 2>&1 || :; exit 0;;            # hook 用。常に 0、何も出さない
  role-context) ( go_exec "$@" ) 2>/dev/null || :; exit 0;;         # hook 用。常に 0
esac
go_exec "$@"
