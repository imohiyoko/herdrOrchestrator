#!/usr/bin/env bash
# 疑似 herdr。FAKE_STATUS(既定 idle。missing なら agent_not_found) / FAKE_PROMPT_RC / FAKE_LOG を使う
case "$1 $2" in
  "agent get")
    echo "get $3" >>"${FAKE_LOG:?}"
    [[ -n ${FAKE_SESSION_LOG:-} ]] && echo "session=${HERDR_SESSION:-}" >>"$FAKE_SESSION_LOG"
    if [[ ${FAKE_STATUS:-idle} == missing ]]; then
      echo '{"error":{"code":"agent_not_found","message":"not found"}}'; exit 1
    fi
    # FAKE_READY_AFTER=N: 最初の N 回の get は interactive_ready=false(起動直後の UI 未準備)
    ready=true
    if [[ -n ${FAKE_READY_AFTER:-} ]]; then
      n=$(( $(cat "$FAKE_LOG.ready" 2>/dev/null || echo 0) + 1 )); echo "$n" >"$FAKE_LOG.ready"
      (( n > FAKE_READY_AFTER )) || ready=false
    fi
    st=${FAKE_STATUS:-idle}
    [[ -e $FAKE_LOG.working ]] && st=working   # 送信が受け付けられた後(FAKE_PROMPT_MODE)
    echo "{\"result\":{\"agent\":{\"agent_status\":\"$st\",\"interactive_ready\":$ready},\"type\":\"agent_info\"}}";;
  "agent read")
    printf 'read %s\t%s\n' "$3" "${*:4}" >>"${FAKE_LOG:?}"
    [[ ${FAKE_READ_RC:-0} == 0 ]] || exit "$FAKE_READ_RC"
    if [[ -n ${FAKE_READ_TEXT:-} ]]; then printf '%s\n' "$FAKE_READ_TEXT"; else echo "screen of $3"; fi;;
  "agent send-keys")
    printf 'keys %s\t%s\n' "$3" "${*:4}" >>"${FAKE_LOG:?}"
    # swallow-once: 失われた Enter の代わりに、これで初めて送信される(= 動き出す)
    [[ ${FAKE_PROMPT_MODE:-} == swallow-once && $4 == Enter ]] && : >"$FAKE_LOG.working"
    echo '{"result":{"type":"ok"}}';;
  "agent list")
    echo "list" >>"${FAKE_LOG:?}"
    [[ ${FAKE_LIST_FAIL:-0} == 1 ]] && { echo '{"error":{"code":"x"}}'; exit 1; }
    [[ ${FAKE_LIST_BAD:-0} == 1 ]] && { echo '{"result":{}}'; exit 0; }   # 形の違う一覧(agents が無い)
    # FAKE_AGENTS(JSON 配列)で差し替え可。既定は worker1(wW:p1) と名前なし(wW:p2)
    default='[{"pane_id":"wW:p1","name":"worker1","agent_session":{"value":"sess-w1"}},{"pane_id":"wW:p2","agent_session":{"value":"sess-w2"}}]'
    list=${FAKE_AGENTS:-$default}
    # FAKE_DYNAMIC=1: pane close で一覧から消え(起動した agent も)、agent start(--resume の session を引き継ぐ)で一覧に載る。再起動のテスト用
    if [[ ${FAKE_DYNAMIC:-0} == 1 ]]; then
      touch "$FAKE_LOG.closed" "$FAKE_LOG.started"
      closed=$(jq -Rsc 'split("\n") | map(select(. != ""))' "$FAKE_LOG.closed")
      started=$(jq -sc '.' "$FAKE_LOG.started")
      list=$(jq -c --argjson c "$closed" --argjson s "$started" '[(.[], $s[]) | select(.pane_id as $p | $c | index($p) | not)]' <<<"$list")
    fi
    printf '{"result":{"agents":%s},"type":"agent_list"}\n' "$list";;
  "agent prompt")
    printf 'prompt %s\t%s\n' "$3" "$4" >>"${FAKE_LOG:?}"
    if [[ ${FAKE_PROMPT_RC:-0} != 0 ]]; then echo '{"error":{"code":"x"}}'; exit "$FAKE_PROMPT_RC"; fi
    # FAKE_PROMPT_MODE: work=受け付けられて動き出す / swallow-once=Enter が失われ send-keys Enter で動く / swallow-always=動かない
    [[ ${FAKE_PROMPT_MODE:-} == work ]] && : >"$FAKE_LOG.working"
    echo '{"result":{"type":"ok"}}';;
  "workspace create")
    echo "workspace-create $*" >>"${FAKE_LOG:?}"
    [[ ${FAKE_WS_FAIL:-0} == 1 ]] && { echo '{"error":{"code":"x"}}'; exit 1; }
    echo "{\"result\":{\"workspace\":{\"workspace_id\":\"wN\"},\"root_pane\":{\"pane_id\":\"${FAKE_NEW_PANE:-wA:p1}\"}}}";;
  "pane split")
    # 既存の pane を分ける(agent セットの置き場所)。FAKE_SPLIT_PANE で新しい pane を固定、FAKE_SPLIT_FAIL=1 で失敗
    echo "pane-split ${*:3}" >>"${FAKE_LOG:?}"
    [[ ${FAKE_SPLIT_FAIL:-0} == 1 ]] && { echo '{"error":{"code":"pane_not_found"}}'; exit 1; }
    # 既定の新しい pane は分けるたびに wS:p1, wS:p2, ...(数は $FAKE_LOG.splits)
    echo x >>"$FAKE_LOG.splits"; _sp=wS:p$(wc -l <"$FAKE_LOG.splits" | tr -d ' ')
    echo "{\"result\":{\"pane\":{\"pane_id\":\"${FAKE_SPLIT_PANE:-$_sp}\"}}}";;
  "workspace list")
    echo "workspace-list" >>"${FAKE_LOG:?}"
    [[ ${FAKE_WS_LIST_FAIL:-0} == 1 ]] && { echo '{"error":{"code":"x"}}'; exit 1; }
    # FAKE_WORKSPACES(JSON 配列。例 [{"label":"inc-001"}])。既定は空
    printf '{"result":{"workspaces":%s},"type":"workspace_list"}\n' "${FAKE_WORKSPACES:-[]}";;
  "workspace close")
    echo "workspace-close $3" >>"${FAKE_LOG:?}"
    exit "${FAKE_WS_CLOSE_RC:-0}";;
  "pane process-info")
    # 呼び出し元の確かめ(ADR 0007 段 1a)用。呼んだ tb の HERDR_PANE_ID の pane だけ、テストのプロセス(TB_TEST_SHELL_PID)を最初のプロセスとして返す
    # (テストの tb はその子孫なので「その pane の中」になる)。ほかの pane は誰の祖先でもない pid。FAKE_SHELL_PID で差し替え、FAKE_PINFO_FAIL=1 で失敗
    [[ $3 == --pane ]] || { echo '{"error":{"code":"usage"}}'; exit 2; }   # 本物と同じく --pane ID だけ受け付ける
    [[ ${FAKE_PINFO_FAIL:-0} == 1 ]] && { echo '{"error":{"code":"x"}}'; exit 1; }
    if [[ -n ${FAKE_SHELL_PID:-} ]]; then sp=$FAKE_SHELL_PID
    elif [[ $3 == --pane && $4 == "${HERDR_PANE_ID:-}" && -n ${TB_TEST_SHELL_PID:-} ]]; then sp=$TB_TEST_SHELL_PID
    else sp=999999; fi
    # tb herdr close の確かめ用: FAKE_BG_PANE の pane はシェルの下に子がいる(テストのプロセスを shell_pid にする)、
    # FAKE_FG_PANE の pane は前面のプロセス FAKE_FG(JSON 配列)を返す。FAKE_PINFO_BAD_PANE の pane は読めない形
    [[ -n ${FAKE_BG_PANE:-} && $4 == "$FAKE_BG_PANE" ]] && sp=$TB_TEST_SHELL_PID
    fg='[]'; [[ -n ${FAKE_FG_PANE:-} && $4 == "$FAKE_FG_PANE" ]] && fg=${FAKE_FG:-[]}
    [[ -n ${FAKE_PINFO_BAD_PANE:-} && $4 == "$FAKE_PINFO_BAD_PANE" ]] && { echo '{"result":{}}'; exit 0; }
    printf '{"result":{"process_info":{"pane_id":"%s","shell_pid":%s,"foreground_processes":%s},"type":"pane_process_info"}}\n' "$4" "$sp" "$fg";;
  "pane list")
    # FAKE_PANES(JSON 配列。例 [{"pane_id":"wC:p1","workspace_id":"wC"}])を --workspace で絞る。FAKE_PANE_LIST_FAIL=1 で失敗
    echo "pane-list ${*:3}" >>"${FAKE_LOG:?}"
    [[ ${FAKE_PANE_LIST_FAIL:-0} == 1 ]] && { echo '{"error":{"code":"x"}}'; exit 1; }
    ws=""; [[ ${3:-} == --workspace ]] && ws=$4
    printf '{"result":{"panes":%s},"type":"pane_list"}\n' "$(jq -c --arg w "$ws" '[.[] | select($w == "" or .workspace_id == $w)]' <<<"${FAKE_PANES:-[]}")";;
  "pane close")
    echo "pane-close $3" >>"${FAKE_LOG:?}"
    [[ ${FAKE_CLOSE_RC:-0} == 0 ]] && echo "$3" >>"$FAKE_LOG.closed"
    exit "${FAKE_CLOSE_RC:-0}";;
  "agent start")
    printf 'start %s\n' "${*:3}" >>"${FAKE_LOG:?}"
    if [[ ${FAKE_START_RC:-0} == 0 ]]; then
      # 起動した agent を記録(FAKE_DYNAMIC 用)。session は --resume の値。無ければ FAKE_NEW_SESSION。FAKE_START_SESSION があれば常にそれ
      _sess=${FAKE_NEW_SESSION:-sess-new}; _pane=""; _a=("${@:4}")
      for ((_i = 0; _i < ${#_a[@]}; _i++)); do
        [[ ${_a[_i]} == --resume ]] && _sess=${_a[_i+1]}
        [[ ${_a[_i]} == --pane ]] && _pane=${_a[_i+1]}
      done
      [[ -n ${FAKE_START_SESSION:-} ]] && _sess=$FAKE_START_SESSION
      # 閉じた pane に起動し直したら、その pane は閉じていない扱いに戻す
      if [[ -f $FAKE_LOG.closed && -n $_pane ]]; then grep -vxF -- "$_pane" "$FAKE_LOG.closed" >"$FAKE_LOG.closed.tmp"; mv "$FAKE_LOG.closed.tmp" "$FAKE_LOG.closed"; fi
      jq -nc --arg p "$_pane" --arg n "$3" --arg s "$_sess" '{pane_id:$p,name:$n,agent_status:"idle",agent_session:{value:$s},cwd:"/tmp"}' >>"$FAKE_LOG.started"
    fi
    # FAKE_START_OUT: 起動の出力(失敗時のエラー JSON などを試す)
    [[ -n ${FAKE_START_OUT:-} ]] && printf '%s\n' "$FAKE_START_OUT"
    exit "${FAKE_START_RC:-0}";;
  *) echo "fake-herdr: unsupported: $*" >&2; exit 99;;
esac
